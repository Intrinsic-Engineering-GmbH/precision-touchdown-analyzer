# Copy to .env and adjust. (chmod 600 .env)

# The analyzer on the judge PC pushes the board to this Pi with this token;
# the same value goes into the analyzer's launcher ("Public scoreboard").
# Letters and digits only - make one with:  openssl rand -hex 24
PUSH_TOKEN=

# The Pi's port the analyzer pushes to. The local network only: the router
# must not forward it.
PUSH_PORT=5054

# The Pi's port for plain http:// (the board). With HTTPS on, pick another
# one than HTTPS_PORT; it is then for the local network only.
RELAY_PORT=5051

# HTTPS with the provider's certificate (certs/certificate.pfx, unpacked by
# reload-cert.sh): its password, the public name, and the port the router
# forwards. Switch it on with the line below.
PFX_PASSWORD=
PUBLIC_HOST=touchdown.fahmi.ch
HTTPS_PORT=5051
# COMPOSE_PROFILES=https
# RELAY_PORT=5052
