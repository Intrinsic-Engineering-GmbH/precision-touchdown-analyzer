ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------------------
# Project: local data and generated output
