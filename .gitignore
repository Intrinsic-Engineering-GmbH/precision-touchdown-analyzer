# ---------------------------------------------------------------------------
# Secrets / local configuration  (NEVER commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
# exported site settings carry the camera password and the relay token
*.pta
/backups/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
# VS Code: shared settings are committed, per-user state is not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/
*.code-workspace

# JetBrains
.idea/

